      },
      "xlabel": {
        "comment": "xlabel"
      },
      "legend_labels": {
        "comment": "自定义图例"
      },
      "title": {
        "comment": "title"
      },
      "ylabel": {
        "comment": "ylabel"
      }
    },
    "output_file_label": "XPS-PNG",
    "output_pattern": "{label_name}.png",
    "tool_type": "single",
    "comment": "标点渲染器：读取包含坐标和样式信息的 JSON 文件（支持单个或多个文件），并将其绘制在图表上。常与 csv_find_points 配合使用。"
  }
}
      },
      "fig_height": {
        "value": 5.0,
        "comment": "图片高度"
      },
      "show_legend": {
        "value": true,
        "comment": "显示legand"
      },
      "show_xticks": true,
      "show_yticks": true,
      "x_scale": "linear",
      "y_scale": "linear",
      "row_by": "attr",
      "share_x": true,
      "share_y": false,
      "facet_wspace": 0.0,
      "facet_hspace": 0.0,

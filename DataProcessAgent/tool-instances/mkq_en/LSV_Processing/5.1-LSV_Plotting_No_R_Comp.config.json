      },
      "xlabel": {
        "value": "$E\\, \\text{ (V vs. RHE)}$",
        "comment": "xlabel"
      },
      "ylabel": {
        "value": "$j \\text{ (mA cm}^{-2}\\text{)}$",
        "comment": "ylabel"
      },
      "title_template": {
        "value": "LSV of {batch}-{item}",
        "comment": "title"
      },
      "font_name": {
